{
  "name": "trading-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "android:sync": "npm run build && cap sync android",
    "android:build": "cd android && JAVA_HOME=${JAVA_HOME:-$HOME/.local/opt/jdk-21} ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk} ./gradlew assembleDebug",
    "android:install": "${ANDROID_HOME:-$HOME/Android/Sdk}/platform-tools/adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android": "npm run android:sync && npm run android:build && npm run android:install"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@fontsource/roboto": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "highlight.js": "11.11.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "8.3.1",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
